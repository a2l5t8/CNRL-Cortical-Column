\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \textbf  {Source-disjoint Caltech Faces search protocol.} The model is trained on centered \emph  {Faces\_easy} and Motorbikes. It is then frozen and scanned over non-centered \emph  {Faces} images using the same spiking column and candidate saccade geometry. Ground-truth boxes are reserved for final evaluation.}}{9}{figure.caption.9}\protected@file@percent }
\newlabel{fig:face_protocol}{{10}{9}{\textbf {Source-disjoint Caltech Faces search protocol.} The model is trained on centered \emph {Faces\_easy} and Motorbikes. It is then frozen and scanned over non-centered \emph {Faces} images using the same spiking column and candidate saccade geometry. Ground-truth boxes are reserved for final evaluation}{figure.caption.9}{}}
\newlabel{fig:face_protocol@cref}{{[figure][10][]10}{[1][8][]9}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces \textbf  {Qualitative face-localization examples.} Examples show selected windows, ground-truth boxes, and evidence maps for unseen non-centered \emph  {Faces}. The selected window tracks the object rather than the image centre when the reference-frame sequence is preserved.}}{9}{figure.caption.10}\protected@file@percent }
\newlabel{fig:face_examples}{{11}{9}{\textbf {Qualitative face-localization examples.} Examples show selected windows, ground-truth boxes, and evidence maps for unseen non-centered \emph {Faces}. The selected window tracks the object rather than the image centre when the reference-frame sequence is preserved}{figure.caption.10}{}}
\newlabel{fig:face_examples@cref}{{[figure][11][]11}{[1][8][]9}{}{}{}}
\citation{gerstner2002}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \textbf  {Quantitative localization metrics.} Normal ordered L5/6{} scans outperform reversed, silent, and fixed-prior controls in mean IoU and CorLoc, with the strongest separation on displaced faces. Oracle performance reports the best candidate window available to the scan grid.}}{10}{figure.caption.11}\protected@file@percent }
\newlabel{fig:face_metrics}{{12}{10}{\textbf {Quantitative localization metrics.} Normal ordered \Lfive {} scans outperform reversed, silent, and fixed-prior controls in mean IoU and CorLoc, with the strongest separation on displaced faces. Oracle performance reports the best candidate window available to the scan grid}{figure.caption.11}{}}
\newlabel{fig:face_metrics@cref}{{[figure][12][]12}{[1][8][]10}{}{}{}}
