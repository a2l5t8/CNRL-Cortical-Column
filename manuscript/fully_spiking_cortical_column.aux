\@writefile{toc}{\contentsline {section}{\numberline {1}Introduction}{1}{section.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Fully spiking cortical-column architecture.} Raw images are sampled by nine saccades. Retinal spikes drive L4{} convolutional filters, pooled L2/3{} winners represent sparse local features, and a current-driven L5/6{} LIF population represents the current location in a $3\times 3$ reference frame. A physical apical synapse primes L2/3{} from L5/6{}. A reciprocal L2/3{}$\rightarrow $L5/6{} synapse is trained by local coactivity and opened during feature-to-frame retrieval assays. Both binding projections learn concurrently with decision eligibility during acquisition. The decision layer receives only location-gated feature spikes and is modulated after an unclamped free decision.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:architecture}{{1}{2}{\textbf {Fully spiking cortical-column architecture.} Raw images are sampled by nine saccades. Retinal spikes drive \Lfour {} convolutional filters, pooled \Lthree {} winners represent sparse local features, and a current-driven \Lfive {} LIF population represents the current location in a $3\times 3$ reference frame. A physical apical synapse primes \Lthree {} from \Lfive {}. A reciprocal \Lthree {}$\rightarrow $\Lfive {} synapse is trained by local coactivity and opened during feature-to-frame retrieval assays. Both binding projections learn concurrently with decision eligibility during acquisition. The decision layer receives only location-gated feature spikes and is modulated after an unclamped free decision}{figure.caption.1}{}}
\newlabel{fig:architecture@cref}{{[figure][1][]1}{[1][2][]2}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2}Results}{2}{section.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.1}Joint online acquisition preserves held-out accuracy}{2}{subsection.2.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}Reference-frame spikes are causal for spatial evidence}{2}{subsection.2.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Primary held-out performance after joint acquisition.} Intervals for the endpoint checkpoints are exact binomial intervals; multiseed intervals are across five decision-layer training seeds.}}{3}{table.caption.2}\protected@file@percent }
\newlabel{tab:performance}{{1}{3}{\textbf {Primary held-out performance after joint acquisition.} Intervals for the endpoint checkpoints are exact binomial intervals; multiseed intervals are across five decision-layer training seeds}{table.caption.2}{}}
\newlabel{tab:performance@cref}{{[table][1][]1}{[1][2][]3}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Held-out accuracy and reference-frame controls.} Ordered L5/6{} reference-frame spikes reproduce live inference. Reversing, shuffling, or silencing L5/6{} strongly degrades accuracy. Accuracy grows over ordered saccades, especially on MNIST, showing evidence accumulation rather than a single-glimpse readout.}}{3}{figure.caption.3}\protected@file@percent }
\newlabel{fig:performance_controls}{{2}{3}{\textbf {Held-out accuracy and reference-frame controls.} Ordered \Lfive {} reference-frame spikes reproduce live inference. Reversing, shuffling, or silencing \Lfive {} strongly degrades accuracy. Accuracy grows over ordered saccades, especially on MNIST, showing evidence accumulation rather than a single-glimpse readout}{figure.caption.3}{}}
\newlabel{fig:performance_controls@cref}{{[figure][2][]2}{[1][2][]3}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.4}Feature-location binding works in both directions}{3}{subsection.2.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Replication, ablations, and matched non-spiking readouts.} \textbf  {A} Five decision-plasticity seeds preserve Caltech accuracy and produce a tight MNIST range. \textbf  {B} Causal ablations show that ordered L5/6{} gating, location-specific decision weights, and dopamine-gated learning are required, especially on MNIST. \textbf  {C} Matched non-spiking readouts on the same cached events are shown as analysis baselines, not as part of the model. A sparse spatial logistic readout approaches the spiking endpoint, whereas a location-agnostic rate readout drops substantially and shuffled-label readouts return to chance.}}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:multiseed}{{3}{4}{\textbf {Replication, ablations, and matched non-spiking readouts.} \textbf {A} Five decision-plasticity seeds preserve Caltech accuracy and produce a tight MNIST range. \textbf {B} Causal ablations show that ordered \Lfive {} gating, location-specific decision weights, and dopamine-gated learning are required, especially on MNIST. \textbf {C} Matched non-spiking readouts on the same cached events are shown as analysis baselines, not as part of the model. A sparse spatial logistic readout approaches the spiking endpoint, whereas a location-agnostic rate readout drops substantially and shuffled-label readouts return to chance}{figure.caption.4}{}}
\newlabel{fig:multiseed@cref}{{[figure][3][]3}{[1][3][]4}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}Ambiguous early evidence is resolved by later reference-frame input}{4}{subsection.2.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Reference-frame-gated evidence resolves ambiguous early glimpses.} Decision-spike traces are plotted after each saccade for example Caltech and MNIST samples. The correct class becomes dominant only when later feature spikes arrive at their matched L5/6{} locations. Reversing, shuffling, or silencing the location sequence disrupts the evidence trajectory.}}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:ambiguity}{{4}{4}{\textbf {Reference-frame-gated evidence resolves ambiguous early glimpses.} Decision-spike traces are plotted after each saccade for example Caltech and MNIST samples. The correct class becomes dominant only when later feature spikes arrive at their matched \Lfive {} locations. Reversing, shuffling, or silencing the location sequence disrupts the evidence trajectory}{figure.caption.4}{}}
\newlabel{fig:ambiguity@cref}{{[figure][4][]4}{[1][3][]4}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Bidirectional feature-location binding in spiking populations.} Feature-to-frame retrieval receives a L2/3{} spike cue and predicts the L5/6{} location. Frame-to-feature stimulation injects current into a L5/6{} LIF location unit while visual input is clamped to zero and measures the resulting L2/3{} prime. Matched locations are consistently stronger than reversed-location controls.}}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:bidirectional}{{5}{5}{\textbf {Bidirectional feature-location binding in spiking populations.} Feature-to-frame retrieval receives a \Lthree {} spike cue and predicts the \Lfive {} location. Frame-to-feature stimulation injects current into a \Lfive {} LIF location unit while visual input is clamped to zero and measures the resulting \Lthree {} prime. Matched locations are consistently stronger than reversed-location controls}{figure.caption.5}{}}
\newlabel{fig:bidirectional@cref}{{[figure][5][]5}{[1][3][]5}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {The same visual feature across images retrieves a shared reference-frame representation.} Held-out samples from the same class and saccade location are compared through their sparse L2/3{} events and retrieved L5/6{} locations. The assay tests whether the learned binding generalises across images rather than storing only a single exemplar.}}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:cross_image}{{6}{6}{\textbf {The same visual feature across images retrieves a shared reference-frame representation.} Held-out samples from the same class and saccade location are compared through their sparse \Lthree {} events and retrieved \Lfive {} locations. The assay tests whether the learned binding generalises across images rather than storing only a single exemplar}{figure.caption.6}{}}
\newlabel{fig:cross_image@cref}{{[figure][6][]6}{[1][3][]6}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Location-specific binding matrices.} Rows and columns summarise how learned apical and retrieval weights associate L2/3{} features with L5/6{} reference-frame locations. The block structure is weakened by shuffled controls, consistent with learned feature-location binding rather than a location-independent feature prior.}}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:binding_matrices}{{7}{6}{\textbf {Location-specific binding matrices.} Rows and columns summarise how learned apical and retrieval weights associate \Lthree {} features with \Lfive {} reference-frame locations. The block structure is weakened by shuffled controls, consistent with learned feature-location binding rather than a location-independent feature prior}{figure.caption.6}{}}
\newlabel{fig:binding_matrices@cref}{{[figure][7][]7}{[1][3][]6}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Prospective reference-frame priming.} With visual input clamped to zero, current-driven L5/6{} spikes prime L2/3{} features expected at the stimulated location. Matched primes outperform reversed, shuffled, global-prior, and random controls on both datasets, and feature cues retrieve the corresponding L5/6{} location.}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:prospective}{{8}{7}{\textbf {Prospective reference-frame priming.} With visual input clamped to zero, current-driven \Lfive {} spikes prime \Lthree {} features expected at the stimulated location. Matched primes outperform reversed, shuffled, global-prior, and random controls on both datasets, and feature cues retrieve the corresponding \Lfive {} location}{figure.caption.7}{}}
\newlabel{fig:prospective@cref}{{[figure][8][]8}{[1][3][]7}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {L4{} kernel evolution during unsupervised local learning.} Kernels are shown at initial, early, middle, and final training stages. The quantitative panels report RMS change, spatial autocorrelation, response selectivity, saturation, and held-out winner coverage, demonstrating that the filters learn and then stabilise rather than remaining random.}}{8}{figure.caption.8}\protected@file@percent }
\newlabel{fig:l4kernels}{{9}{8}{\textbf {\Lfour {} kernel evolution during unsupervised local learning.} Kernels are shown at initial, early, middle, and final training stages. The quantitative panels report RMS change, spatial autocorrelation, response selectivity, saturation, and held-out winner coverage, demonstrating that the filters learn and then stabilise rather than remaining random}{figure.caption.8}{}}
\newlabel{fig:l4kernels@cref}{{[figure][9][]9}{[1][8][]8}{}{}{}}
